# Line endings are decided here rather than by whatever core.autocrlf each
# machine happens to have set, so a clone on Windows and a clone on Linux give
# byte identical files and nobody sees a whole file rewritten as a diff.

# Everything git considers text is stored and checked out as LF.
* text=auto eol=lf

# Except the Windows batch scripts, which want CRLF on disk.
*.bat text eol=crlf
*.cmd text eol=crlf

# The Gradle wrapper is a shell script. CRLF here stops it running.
gradlew text eol=lf

# Never touched, never diffed as text.
*.jar binary
*.png binary
*.ico binary
*.zip binary
*.nbt binary
*.sschem binary
*.litematic binary
